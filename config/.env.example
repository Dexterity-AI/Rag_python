# =====================
# Neo4j 图数据库配置
# =====================
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# =====================
# Milvus 向量数据库配置
# =====================
# 使用 docker-compose 时，主机名为服务名
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=travel_knowledge

# =====================
# LLM 大语言模型配置
# =====================
# 支持 OpenAI 兼容的 API (如 DeepSeek, OpenAI, MiniMax 等)
LLM_MODEL=MiniMax-M2.5
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.minimaxi.com/v1

# =====================
# Embedding 模型配置
# =====================
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# =====================
# 检索配置
# =====================
TOP_K=5

# =====================
# 生成配置
# =====================
TEMPERATURE=0.1
MAX_TOKENS=2048

# =====================
# 文档处理配置
# =====================
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_GRAPH_DEPTH=2

# =====================
# 查询路由配置（轻量级优化）
# =====================
# 是否启用LLM进行路由决策（默认false，使用轻量级规则）
# 设置为true会增加延迟和成本，仅在需要极高精度时启用
ENABLE_LLM_ROUTING=false

# 路由决策缓存大小（默认1000）
ROUTER_CACHE_SIZE=1000

# =====================
# Docker Volume 路径配置
# =====================
# 数据卷存储路径（默认当前目录）
DOCKER_VOLUME_DIRECTORY=.

# =====================
# 数据采集工具配置
# =====================
# ToolBbrowser 浏览器自动化工具
TOOLBBROWSER_ENABLED=true
TOOLBBROWSER_PATH=./ToolBbrowser
TOOLBBROWSER_NODE_PATH=node
TOOLBBROWSER_TIMEOUT=60

# Scrapling Python 爬虫框架
SCRAPLING_ENABLED=true
SCRAPLING_PATH=./Scrapling-main
SCRAPLING_DEFAULT_FETCHER=fetcher
SCRAPLING_TIMEOUT=30
SCRAPLING_RETRY_COUNT=3

# =====================
# 数据存储配置
# =====================
# 数据根目录
DATA_ROOT=./data

# 是否保存原始数据
COLLECTOR_SAVE_RAW=true

# 是否保存标准化后的数据
COLLECTOR_SAVE_NORMALIZED=true
