# GraphRAG 环境变量配置示例
# 复制此文件为 .env 并填入你的配置

# =====================
# Docker 镜像源配置 (国内用户必看!)
# =====================
# 如果拉取镜像失败，请取消下面注释并使用镜像代理
# 可选值: docker.1ms.run/ 或 dockerpull.org/ 或 docker.rainbond.cc/
# 注意: 末尾必须有斜杠 /
# REGISTRY_MIRROR=docker.1ms.run/

# =====================
# Neo4j 图数据库配置
# =====================
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=18579944517
NEO4J_DATABASE=neo4j

# =====================
# Milvus 向量数据库配置
# =====================
# 使用 docker-compose 时，主机名为服务名
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=travel_knowledge

# =====================
# LLM 大语言模型配置
# =====================
# 支持 OpenAI 兼容的 API (如 DeepSeek, OpenAI 等)
LLM_MODEL=deepseek-chat
LLM_API_KEY=sk-a2bd4bba0f334a3cb45ccfcdb390781d
LLM_BASE_URL=https://api.deepseek.com/v1

# =====================
# Embedding 模型配置
# =====================
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# =====================
# 检索配置
# =====================
TOP_K=5

# =====================
# 生成配置
# =====================
TEMPERATURE=0.1
MAX_TOKENS=2048

# =====================
# 文档处理配置
# =====================
CHUNK_SIZE=500
CHUNK_OVERLAP=50
MAX_GRAPH_DEPTH=2

# =====================
# Docker Volume 路径 (可选)
# =====================
DOCKER_VOLUME_DIRECTORY=.
